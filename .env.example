# Copie para .env e preencha com os dados do seu projeto Supabase.
# (Supabase > Project Settings > Database > Connection string)

# Conexão "Transaction pooler" (porta 6543) — usada pelo app
DATABASE_URL="postgresql://postgres.XXXX:SENHA@aws-0-sa-east-1.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"

# Conexão direta (porta 5432) — usada só para migrações
DIRECT_URL="postgresql://postgres.XXXX:SENHA@aws-0-sa-east-1.pooler.supabase.com:5432/postgres"

# Segredo para assinar a sessão. Gere um valor aleatório longo, ex.:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
AUTH_SECRET="troque-por-um-valor-aleatorio-longo"
